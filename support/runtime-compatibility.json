        "id": "node",
        "version": "16.20.2"
      },
      "packages": [
        "@sqlbraid/core",
        "@sqlbraid/template",
        "@sqlbraid/runtime",
        "@sqlbraid/operations",
        "@sqlbraid/postgres",
        "@sqlbraid/mysql",
        "@sqlbraid/mariadb",
        "@sqlbraid/sqlite",
        "@sqlbraid/oracle",
        "@sqlbraid/mssql",
        "@sqlbraid/bun-sql",
        "sqlbraid"
      ],
      "driver": null,
      "smoke": {
        "entrypoint": "scripts/runtime-compatibility-smoke.mjs"
      },
      "releaseBlocking": true,
      "reason": "Candidate portable package floor; node:sqlite is intentionally not imported by this cell."
    },
    {
      "id": "node-16-20-2-better-sqlite3-9-6-0",
      "runtime": {
        "id": "node",
        "version": "16.20.2"
      },
      "packages": [
        "@sqlbraid/core",
        "@sqlbraid/template",
        "@sqlbraid/runtime",
        "@sqlbraid/postgres",
        "@sqlbraid/mysql",
        "@sqlbraid/mariadb",
        "@sqlbraid/sqlite",
        "@sqlbraid/oracle",
        "@sqlbraid/mssql",
        "@sqlbraid/bun-sql",
        "sqlbraid"
      ],
      "driver": {
        "package": "better-sqlite3",
        "version": "9.6.0"
      },
      "smoke": {
        "entrypoint": "scripts/runtime-compatibility-smoke.mjs"
      },
      "releaseBlocking": true,
      "reason": "Historical better-sqlite3 line selected for the candidate Node floor."
    },
    {
      "id": "node-22-18-0-better-sqlite3-13-0-3",
      "runtime": {
        "id": "node",
        "version": "22.18.0"
      },
      "packages": [
        "@sqlbraid/core",
        "@sqlbraid/template",
        "@sqlbraid/runtime",
        "@sqlbraid/postgres",
        "@sqlbraid/mysql",
        "@sqlbraid/mariadb",
        "@sqlbraid/sqlite",
        "@sqlbraid/oracle",
        "@sqlbraid/mssql",
        "@sqlbraid/bun-sql",
        "sqlbraid"
      ],
      "driver": {
        "package": "better-sqlite3",
        "version": "13.0.3"
      },
      "smoke": {
        "entrypoint": "scripts/runtime-compatibility-smoke.mjs"
      },
      "releaseBlocking": true,
      "reason": "Current better-sqlite3 line requires modern Node."
    },
    {
      "id": "node-16-20-2-libsql-0-18-0",
      "runtime": {
        "id": "node",
        "version": "16.20.2"
      },
      "packages": [
        "@sqlbraid/core",
        "@sqlbraid/template",
        "@sqlbraid/runtime",
        "@sqlbraid/postgres",
        "@sqlbraid/mysql",
        "@sqlbraid/mariadb",
