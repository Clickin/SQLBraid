        "version": "0.18.0"
      },
      "smoke": {
        "entrypoint": "scripts/runtime-compatibility-smoke.mjs"
      },
      "releaseBlocking": true,
      "reason": "Local libSQL client line selected for the candidate Node floor."
    },
    {
      "id": "node-16-20-2-opentelemetry-api-1-9-1",
      "runtime": { "id": "node", "version": "16.20.2" },
      "packages": ["@sqlbraid/core", "@sqlbraid/opentelemetry"],
      "driver": null,
      "smoke": { "entrypoint": "tests/scripts/otel-api-consumer.mjs" },
      "releaseBlocking": true,
      "reason": "Optional API-only bridge floor; SDK/exporter compatibility is tested separately on modern Node."
    }
  ]
