{
  "id": "postgres-pg-node-16-4",
  "status": "official",
  "database": {
    "product": "postgres",
    "version": "16.4",
    "edition": "alpine"
  },
  "driver": {
    "id": "pg",
    "version": "8.23.0",
    "profile": "pg-lossless-text",
    "package": "@sqlbraid/postgres",
    "transport": "text-positional ($1..$N)",
    "stream": "pg-cursor",
    "routine": "SQL CALL; OUT row and transaction-owned refcursor FETCH",
    "bulk": "prepared-loop",
    "exclusions": [
      "PostgreSQL 18-only syntax is not covered by this 16.4 target",
      "Bun and Deno pg subpaths are not certified by this target"
    ],
    "requiredOptions": {
      "parserProfile": {
        "json": "text",
        "temporal": "text"
      }
    },
    "driverRawRepresentations": {
      "integer": "string",
      "decimal": "string",
      "json": "string",
      "temporal": "string"
    },
    "sqlbraidRepresentations": {
      "integer": "string",
      "decimal": "string",
      "json": "string",
      "temporal": "string"
    }
  },
  "runtime": {
    "id": "node",
    "version": "22.18.0"
  },
  "reproducibility": {
    "zeroCost": true,
    "description": "GitHub Actions PostgreSQL service using postgres:16.4-alpine.",
    "image": "postgres:16.4-alpine",
    "url": "https://github.com/Clickin/SQLBraid/actions/workflows/release.yml"
  },
  "ci": {
    "command": "pnpm exec vitest run",
    "workflow": ".github/workflows/release.yml",
    "releaseBlocking": true
  },
  "numeric": {
    "exact-integer": {
      "semantics": "exact-integer",
      "representation": "string",
      "fidelity": "lossless",
      "profile": "pg-lossless-text"
    },
    "exact-decimal": {
      "semantics": "exact-decimal",
      "representation": "string",
      "fidelity": "lossless",
      "profile": "pg-lossless-text"
    },
    "approximate-binary": {
      "semantics": "approximate-binary",
      "representation": "number",
      "fidelity": "guarded",
      "profile": "pg-lossless-text"
    }
  },
  "containers": {
    "postgres-arrays": "unclassified",
    "postgres-domains": "unclassified",
    "postgres-ranges": "unclassified",
    "postgres-composites": "unclassified",
    "oracle-objects": "unsupported",
    "sql-server-variant": "unsupported",
    "json-nested": "unclassified",
    "vector": "unclassified"
