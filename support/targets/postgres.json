{
  "id": "postgres-pg-node-16-4",
  "status": "official",
  "database": { "product": "postgres", "version": "16.4", "edition": "alpine" },
  "driver": {
    "id": "pg",
    "version": "8.23.0",
    "profile": "node-postgres",
    "package": "@sqlbraid/postgres",
    "transport": "text-positional ($1..$N)",
    "stream": "pg-cursor",
    "routine": "SQL CALL; OUT row and transaction-owned refcursor FETCH",
    "bulk": "prepared-loop",
    "rawRepresentations": { "integer": "int8 string", "decimal": "string", "json": "object", "temporal": "Date or string by OID" },
    "exclusions": ["PostgreSQL 18-only syntax is not covered by this 16.4 target", "Bun and Deno pg subpaths are not certified by this target"]
  },
  "runtime": { "id": "node", "version": "22.18.0" },
  "reproducibility": {
    "zeroCost": true,
    "description": "GitHub Actions PostgreSQL service using postgres:16.4-alpine.",
    "image": "postgres:16.4-alpine",
    "url": "https://github.com/Clickin/SQLBraid/actions/workflows/release.yml"
  },
  "ci": { "command": "pnpm run test:db:postgres", "workflow": ".github/workflows/release.yml", "releaseBlocking": true },
  "capabilities": {
    "sql.native-transparency": { "status": "guaranteed", "testIds": ["postgres.sql.native-transparency"] },
    "sql.generated-structure": { "status": "guaranteed", "testIds": ["postgres.sql.generated-structure"] },
    "numeric.exact-integer": { "status": "guaranteed", "canonical": "bigint", "rawRepresentations": ["string"], "testIds": ["postgres.numeric.exact-integer"] },
    "numeric.exact-decimal": { "status": "guaranteed", "canonical": "string", "rawRepresentations": ["string"], "testIds": ["postgres.numeric.exact-decimal"] },
    "numeric.scale-greater-than-precision": { "status": "guaranteed", "canonical": "string", "rawRepresentations": ["string"], "testIds": ["postgres.numeric.scale-greater-than-precision"] },
    "numeric.negative-scale": { "status": "guaranteed", "canonical": "string", "rawRepresentations": ["string"], "testIds": ["postgres.numeric.negative-scale"] },
    "data.json-native": { "status": "guaranteed", "rawRepresentations": ["object"], "testIds": ["postgres.data.json-native"] },
    "data.temporal": { "status": "guaranteed", "rawRepresentations": ["Date", "string"], "testIds": ["postgres.data.temporal"] },
    "data.binary": { "status": "guaranteed", "rawRepresentations": ["Buffer", "Uint8Array"], "testIds": ["postgres.data.binary"] },
    "data.uuid": { "status": "guaranteed", "rawRepresentations": ["string"], "testIds": ["postgres.data.uuid"] },
    "result.rows": { "status": "guaranteed", "testIds": ["postgres.result.rows"] },
