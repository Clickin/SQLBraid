    "execution.transaction": { "status": "guaranteed", "testIds": ["postgres.execution.transaction"] },
    "execution.savepoint": { "status": "guaranteed", "testIds": ["postgres.execution.savepoint"] },
    "routine.scalar-out": { "status": "guaranteed", "testIds": ["postgres.routine.scalar-out"] },
    "routine.resultsets": { "status": "guaranteed", "testIds": ["postgres.routine.resultsets"] },
