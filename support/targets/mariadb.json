    "exact-decimal": { "semantics": "exact-decimal", "representation": "string", "fidelity": "guarded", "profile": "connector-node-pv17" },
    "approximate-binary": { "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless" }
  },
