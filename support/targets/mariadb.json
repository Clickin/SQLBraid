    "version": "3.5.4",
    "profile": "connector-node-pv17",
    "package": "@sqlbraid/mariadb",
    "transport": "text-positional (?)",
    "stream": "MariaDB Connector stream",
    "routine": "prepared CALL emitted result sets; no OUT/INOUT carrier",
    "bulk": "connector-native-batch",
    "rawRepresentations": { "integer": "bigint", "decimal": "string", "json": "object (autoJsonMap); explicit SQL CAST gives text", "temporal": "Date" },
