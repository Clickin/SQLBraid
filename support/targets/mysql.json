{
  "id": "mysql-mysql2-node-8-4-2",
  "status": "compatible",
  "database": { "product": "mysql", "version": "8.4.2", "edition": "community" },
  "driver": {
    "id": "mysql2",
    "version": "3.24.4",
    "profile": "mysql2-exact",
    "package": "@sqlbraid/mysql",
    "transport": "text-positional (?)",
    "stream": "mysql2 prepared Execute.stream",
    "routine": "prepared CALL emitted result sets; no OUT/INOUT carrier",
    "bulk": "prepared-loop",
    "rawRepresentations": { "integer": "string", "decimal": "string", "json": "object", "temporal": "Date" },
    "exclusions": ["MySQL has no generic DML RETURNING capability", "OUT and INOUT carriers are unsupported for ordinary mysql2 execution", "Bun and Deno mysql2 subpaths are not certified by this target"]
  },
  "runtime": { "id": "node", "version": "22.18.0" },
  "reproducibility": {
    "zeroCost": true,
    "description": "GitHub Actions MySQL service using mysql:8.4.2.",
    "image": "mysql:8.4.2",
    "url": "https://github.com/Clickin/SQLBraid/actions/workflows/release.yml"
  },
  "ci": { "command": "pnpm exec vitest run", "workflow": ".github/workflows/release.yml", "releaseBlocking": true },
  "numeric": {
    "exact-integer": { "semantics": "exact-integer", "representation": "string", "fidelity": "guarded", "profile": "mysql2-exact" },
    "exact-decimal": { "semantics": "exact-decimal", "representation": "string", "fidelity": "lossless", "profile": "mysql2-exact" },
    "approximate-binary": { "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless" }
  },
  "containers": {
    "postgres-arrays": "unsupported",
    "postgres-domains": "unsupported",
    "postgres-ranges": "unsupported",
    "postgres-composites": "unsupported",
    "oracle-objects": "unsupported",
    "sql-server-variant": "unsupported",
    "json-nested": "unclassified",
    "vector": "unclassified"
  },
  "capabilities": {
    "sql.native-transparency": { "status": "guaranteed", "testIds": ["mysql.sql.native-transparency"] },
    "sql.generated-structure": { "status": "guaranteed", "testIds": ["mysql.sql.generated-structure"] },
    "numeric.exact-integer": { "status": "guarded", "conditionCode": "mysql2.exact-numeric-profile", "semantics": "exact-integer", "representation": "string", "fidelity": "guarded", "rawRepresentations": ["string"], "testIds": ["mysql.numeric.exact-integer"] },
    "numeric.exact-decimal": { "status": "guaranteed", "semantics": "exact-decimal", "representation": "string", "fidelity": "lossless", "rawRepresentations": ["string"], "testIds": ["mysql.numeric.exact-decimal"] },
    "numeric.approximate-float": { "status": "guaranteed", "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless", "rawRepresentations": ["number"], "testIds": ["mysql.numeric.approximate-float"] },
    "numeric.bind-exact": { "status": "guarded", "conditionCode": "mysql2.exact-numeric-profile", "testIds": ["mysql.numeric.exact-bind"] },
    "data.json-lossless-text": { "status": "guaranteed", "conditionCode": "mysql2.json-strings", "rawRepresentations": ["string"], "testIds": ["mysql.data.json-lossless-text"] },
    "data.temporal-native": { "status": "guarded", "conditionCode": "mysql2.date-strings", "rawRepresentations": ["Date"], "testIds": ["mysql.data.temporal-native"] },
    "data.temporal-lossless": { "status": "guarded", "conditionCode": "mysql2.date-strings", "rawRepresentations": ["string"], "testIds": ["mysql.data.temporal-native"] },
    "data.binary": { "status": "guaranteed", "rawRepresentations": ["Buffer", "Uint8Array"], "testIds": ["mysql.data.binary"] },
    "data.uuid": { "status": "guaranteed", "rawRepresentations": ["string"], "testIds": ["mysql.data.uuid"] },
    "result.rows": { "status": "guaranteed", "testIds": ["mysql.result.rows"] },
    "result.command": { "status": "guaranteed", "testIds": ["mysql.result.command"] },
    "result.multiple-sets": { "status": "guaranteed", "testIds": ["mysql.result.multiple-sets"] },
    "result.standard-schema": { "status": "guaranteed", "testIds": ["mysql.result.standard-schema"] },
    "execution.prepared": { "status": "guaranteed", "testIds": ["mysql.execution.prepared"] },
    "execution.stream": { "status": "guaranteed", "testIds": ["mysql.execution.stream"] },
    "execution.bulk": { "status": "guaranteed", "testIds": ["mysql.execution.bulk"] },
    "execution.transaction": { "status": "guaranteed", "testIds": ["mysql.execution.transaction"] },
    "execution.savepoint": { "status": "guaranteed", "testIds": ["mysql.execution.savepoint"] },
    "routine.resultsets": { "status": "guaranteed", "testIds": ["mysql.routine.resultsets"] },
    "routine.scalar-out": { "status": "unsupported", "testIds": [] },
    "routine.inout": { "status": "unsupported", "testIds": [] },
    "routine.cursor": { "status": "unsupported", "testIds": [] },
    "routine.return-status": { "status": "unsupported", "testIds": [] },
    "metadata.identity": { "status": "guaranteed", "testIds": ["mysql.metadata.identity"] },
    "metadata.generated": { "status": "guaranteed", "testIds": ["mysql.metadata.generated"] },
    "metadata.routines": { "status": "guaranteed", "testIds": ["mysql.metadata.routines"] },
    "metadata.types": { "status": "guaranteed", "testIds": ["mysql.metadata.types"] },
    "dml.insert-returning": { "status": "unsupported", "testIds": [] },
    "dml.update-returning": { "status": "unsupported", "testIds": [] },
    "dml.delete-returning": { "status": "unsupported", "testIds": [] }
  },
  "evidence": { "status": "pending", "runs": [] }
}
