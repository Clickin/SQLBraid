{
  "id": "oracle-oracledb-thin-node-23-9",
  "status": "compatible",
  "database": { "product": "oracle", "version": "23.9", "edition": "Free" },
  "driver": {
    "id": "node-oracledb",
    "version": "7.0.1",
    "profile": "thin",
    "package": "@sqlbraid/oracle",
    "transport": "text-positional (:1..:N)",
    "stream": "node-oracledb ResultSet",
    "routine": "PL/SQL OUT/INOUT binds; REF CURSOR and implicit ResultSet",
    "bulk": "executeMany",
    "rawRepresentations": { "integer": "string", "decimal": "string", "json": "object", "temporal": "Date" },
    "exclusions": ["This is Oracle Free 23.9 evidence, not Oracle Database 19c evidence", "Oracle Thick mode is not covered", "Bun and Deno node-oracledb subpaths are not certified by this target"]
  },
  "runtime": { "id": "node", "version": "22.18.0" },
  "reproducibility": {
    "zeroCost": true,
    "description": "Testcontainers gvenzl/oracle-free:23.9-slim-faststart with the SQLBraid test user.",
    "image": "gvenzl/oracle-free:23.9-slim-faststart",
    "url": "https://github.com/Clickin/SQLBraid/actions/workflows/release.yml"
  },
  "ci": { "command": "pnpm exec vitest run", "workflow": ".github/workflows/release.yml", "releaseBlocking": true },
  "numeric": {
    "exact-integer": { "semantics": "exact-integer", "representation": "string", "fidelity": "unsupported", "profile": "thin" },
    "exact-decimal": { "semantics": "exact-decimal", "representation": "string", "fidelity": "lossless", "profile": "thin" },
    "approximate-binary": { "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless", "profile": "thin" }
  },
  "containers": {
    "postgres-arrays": "unsupported",
    "postgres-domains": "unsupported",
    "postgres-ranges": "unsupported",
    "postgres-composites": "unsupported",
    "oracle-objects": "unclassified",
    "sql-server-variant": "unsupported",
    "json-nested": "unclassified",
    "vector": "unclassified"
  },
  "capabilities": {
    "sql.native-transparency": { "status": "guaranteed", "testIds": ["oracle.sql.native-transparency"] },
    "sql.generated-structure": { "status": "guaranteed", "testIds": ["oracle.sql.generated-structure"] },
    "numeric.exact-integer": { "status": "unsupported", "semantics": "exact-integer", "representation": "string", "fidelity": "unsupported", "testIds": [] },
    "numeric.exact-decimal": { "status": "guaranteed", "semantics": "exact-decimal", "representation": "string", "fidelity": "lossless", "rawRepresentations": ["string"], "testIds": ["oracle.numeric.exact-decimal"] },
    "numeric.approximate-float": { "status": "guaranteed", "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless", "rawRepresentations": ["number"], "testIds": ["oracle.binary.finite-transport"] },
    "numeric.approximate-special": { "status": "guaranteed", "semantics": "approximate-binary", "representation": "number", "fidelity": "lossless", "rawRepresentations": ["number"], "testIds": ["oracle.binary.nonfinite-probe"] },
    "numeric.bind-exact": { "status": "guarded", "conditionCode": "oracle.bind-nls-sensitive", "testIds": ["oracle.numeric.bind-nls-audit"] },
    "numeric.aggregate": { "status": "guaranteed", "testIds": ["oracle.numeric.aggregate-composite"] },
    "data.json-parsed": { "status": "guaranteed", "rawRepresentations": ["object"], "testIds": ["oracle.data.json-parsed"] },
    "data.json-lossless-text": { "status": "guarded", "conditionCode": "oracle.json-serialize-required", "rawRepresentations": ["string"], "testIds": ["oracle.data.json-lossless-text"] },
    "data.temporal-native": { "status": "guarded", "conditionCode": "oracle.date-millisecond-precision", "rawRepresentations": ["Date"], "testIds": ["oracle.data.temporal-lossless"] },
    "data.temporal-lossless": { "status": "guarded", "conditionCode": "oracle.temporal-text-cast-required", "rawRepresentations": ["string"], "testIds": ["oracle.data.temporal-lossless"] },
    "data.binary": { "status": "guaranteed", "rawRepresentations": ["Buffer", "Uint8Array"], "testIds": ["oracle.data.binary"] },
    "data.uuid": { "status": "guaranteed", "rawRepresentations": ["string"], "testIds": ["oracle.data.uuid"] },
    "result.rows": { "status": "guaranteed", "testIds": ["oracle.result.rows"] },
    "result.command": { "status": "guaranteed", "testIds": ["oracle.result.command"] },
    "result.multiple-sets": { "status": "guaranteed", "testIds": ["oracle.result.multiple-sets"] },
    "result.standard-schema": { "status": "guaranteed", "testIds": ["oracle.result.standard-schema"] },
    "execution.bulk": { "status": "guaranteed", "testIds": ["oracle.execution.bulk"] },
    "execution.stream": { "status": "guaranteed", "testIds": ["oracle.execution.stream"] },
    "execution.transaction": { "status": "guaranteed", "testIds": ["oracle.execution.transaction"] },
    "execution.savepoint": { "status": "guaranteed", "testIds": ["oracle.execution.savepoint"] },
    "execution.prepared": { "status": "unsupported", "testIds": [] },
    "routine.scalar-out": { "status": "guaranteed", "testIds": ["oracle.routine.scalar-out"] },
    "routine.inout": { "status": "guaranteed", "testIds": ["oracle.routine.inout"] },
    "routine.resultsets": { "status": "guaranteed", "testIds": ["oracle.routine.resultsets"] },
    "routine.cursor": { "status": "guaranteed", "testIds": ["oracle.routine.cursor"] },
    "routine.return-status": { "status": "unsupported", "testIds": [] },
    "metadata.identity": { "status": "guaranteed", "testIds": ["oracle.metadata.identity"] },
    "metadata.generated": { "status": "guaranteed", "testIds": ["oracle.metadata.generated"] },
    "metadata.routines": { "status": "guaranteed", "testIds": ["oracle.metadata.routines"] },
    "metadata.types": { "status": "guaranteed", "testIds": ["oracle.metadata.types"] },
    "dml.insert-returning": { "status": "guaranteed", "testIds": ["oracle.dml.insert-returning"] },
    "dml.update-returning": { "status": "guaranteed", "testIds": ["oracle.dml.update-returning"] },
    "dml.delete-returning": { "status": "guaranteed", "testIds": ["oracle.dml.delete-returning"] },
    "metadata.command-safe": { "status": "guarded", "conditionCode": "oracle.count-safe-integer", "testIds": ["oracle.command.safe-count"] }
  },
  "evidence": { "status": "pending", "runs": [] }
}
