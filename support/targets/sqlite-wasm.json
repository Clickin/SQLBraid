{
  "id": "sqlite-wasm-browser-3-53-4",
  "status": "compatible",
  "database": { "product": "sqlite", "version": "3.53.4", "edition": "official SQLite WASM OO1" },
  "driver": {
    "id": "sqlite-wasm",
    "version": "3.53.4-build1",
