  "driver": {
    "id": "bun-sql",
    "version": "1.3.14",
    "profile": "bun-sql-mariadb-1.3.14",
    "package": "@sqlbraid/bun-sql",
    "transport": "text-positional (?)",
    "stream": "unsupported",
    "routine": "unsupported",
    "bulk": "prepared-loop",
    "requiredOptions": {
      "bigint": true
    },
    "driverRawRepresentations": {
      "integer": "number or bigint; explicit text casts return string",
      "decimal": "Uint8Array containing decimal text",
      "json": "string",
      "temporal": "Date or string",
      "binary": "Uint8Array"
    },
    "sqlbraidRepresentations": {
      "integer": "string; ambiguous integral Number rejects",
      "decimal": "unsupported native bytes; explicit SQL text conversion returns string",
      "json": "string",
      "temporal": "Date or string",
      "binary": "unsupported ambiguous bytes; explicit SQL HEX conversion returns string"
    },
    "exclusions": [
      "Only the exact pinned Bun.SQL backend and configured representation profile are covered.",
      "Integral Number results without database type metadata reject rather than risk exact-numeric loss.",
      "Streaming, routine channels and active statement cancellation are unsupported.",
      "Empty SELECT and zero-affected commands are indistinguishable in Bun metadata and reject after execution; side effects may already have occurred.",
      "Use string input for wide integer binds where the pinned MySQL transport rejects BigInt.",
      "DECIMAL and binary outputs are indistinguishable Uint8Array carriers and reject; author explicit CAST AS CHAR or HEX SQL."
    ]
  },
