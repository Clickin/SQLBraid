{
  "id": "postgres-current",
  "status": "official",
  "database": {
    "product": "postgres",
    "version": "18.6",
    "edition": "alpine"
  },
  "driver": {
    "id": "pg",
    "version": "8.23.0",
    "profile": "pg-lossless-text",
    "package": "@sqlbraid/postgres",
    "transport": "text-positional ($1..$N)",
    "stream": "pg-cursor",
    "routine": "SQL CALL; OUT row and transaction-owned refcursor FETCH",
    "bulk": "prepared-loop",
    "exclusions": [
      "Only the PostgreSQL capability fixture is covered by this current target's gate"
    ],
    "requiredOptions": {
      "parserProfile": {
        "json": "text",
        "temporal": "text"
      }
    },
    "driverRawRepresentations": {
      "integer": "string",
      "decimal": "string",
      "json": "string",
      "temporal": "string"
    },
    "sqlbraidRepresentations": {
      "integer": "string",
      "decimal": "string",
      "json": "string",
      "temporal": "string"
    }
  },
  "runtime": {
    "id": "node",
    "version": "22.18.0"
  },
  "reproducibility": {
    "zeroCost": true,
    "description": "GitHub Actions PostgreSQL current capability job using postgres:18.6-alpine.",
    "image": "postgres:18.6-alpine",
    "url": "https://github.com/Clickin/SQLBraid/actions/workflows/release.yml"
  },
  "ci": {
    "command": "pnpm exec vitest run --project db-postgres tests/db/postgres/capabilities.test.ts",
    "workflow": ".github/workflows/release.yml",
    "releaseBlocking": true
  },
  "numeric": {
    "exact-integer": {
      "semantics": "exact-integer",
      "representation": "string",
      "fidelity": "lossless",
      "profile": "pg-lossless-text"
    },
    "exact-decimal": {
      "semantics": "exact-decimal",
      "representation": "string",
      "fidelity": "lossless",
      "profile": "pg-lossless-text"
    },
    "approximate-binary": {
      "semantics": "approximate-binary",
      "representation": "number",
      "fidelity": "guarded",
      "profile": "pg-lossless-text"
    }
  },
  "containers": {
    "postgres-arrays": "unclassified",
    "postgres-domains": "unclassified",
    "postgres-ranges": "unclassified",
    "postgres-composites": "unclassified",
    "oracle-objects": "unsupported",
    "sql-server-variant": "unsupported",
    "json-nested": "unclassified",
    "vector": "unclassified"
  },
