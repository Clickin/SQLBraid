{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": ["ES2024"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "#async-context": ["packages/runtime/src/async-context.ts"],
      "@sqlbraid/core": ["packages/core/src/index.ts"],
      "@sqlbraid/codegen": ["packages/codegen/src/index.ts"],
      "@sqlbraid/template": ["packages/template/src/index.ts"],
      "@sqlbraid/metadata": ["packages/metadata/src/index.ts"],
      "@sqlbraid/compiler": ["packages/compiler/src/index.ts"],
      "@sqlbraid/vite": ["packages/vite/src/index.ts"],
      "@sqlbraid/tooling": ["packages/tooling/src/index.ts"],
      "@sqlbraid/opentelemetry": ["packages/opentelemetry/src/index.ts"],

      "@sqlbraid/runtime": ["packages/runtime/src/index.ts"],
      "@sqlbraid/operations": ["packages/operations/src/index.ts"],
      "@sqlbraid/language-server": ["packages/language-server/src/index.ts"],
      "@sqlbraid/cli": ["packages/cli/src/index.ts"],
      "@sqlbraid/cli/config": ["packages/cli/src/config.ts"],
      "@sqlbraid/bun-sql": ["packages/bun-sql/src/index.ts"],
      "@sqlbraid/postgres": ["packages/postgres/src/index.ts"],
      "@sqlbraid/oracle": ["packages/oracle/src/index.ts"],
      "@sqlbraid/oracle/oracledb": ["packages/oracle/src/oracledb.ts"],
      "@sqlbraid/oracle/inspector": ["packages/oracle/src/inspector.ts"],
      "@sqlbraid/mssql": ["packages/mssql/src/index.ts"],
      "@sqlbraid/mssql/tedious": ["packages/mssql/src/tedious.ts"],
      "@sqlbraid/mssql/inspector": ["packages/mssql/src/inspector.ts"],
      "@sqlbraid/postgres/inspector": ["packages/postgres/src/inspector.ts"],
      "@sqlbraid/postgres/pg": ["packages/postgres/src/pg.ts"],
      "@sqlbraid/mysql": ["packages/mysql/src/index.ts"],
      "@sqlbraid/mysql/inspector": ["packages/mysql/src/inspector.ts"],
      "@sqlbraid/mysql/mysql2": ["packages/mysql/src/mysql2.ts"],
      "@sqlbraid/mariadb": ["packages/mariadb/src/index.ts"],
      "@sqlbraid/mariadb/mariadb": ["packages/mariadb/src/mariadb.ts"],
      "@sqlbraid/mariadb/inspector": ["packages/mariadb/src/inspector.ts"],
      "@sqlbraid/sqlite": ["packages/sqlite/src/index.ts"],
      "@sqlbraid/sqlite/wasm": ["packages/sqlite/src/wasm.ts"],
      "@sqlbraid/sqlite/d1": ["packages/sqlite/src/d1.ts"],
      "@sqlbraid/sqlite/inspector": ["packages/sqlite/src/inspector.ts"],
      "@sqlbraid/sqlite/node-sqlite": ["packages/sqlite/src/node-sqlite.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
