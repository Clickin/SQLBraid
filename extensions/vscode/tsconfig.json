{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node", "vscode"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
