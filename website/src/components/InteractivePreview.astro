<section class="sqlbraid-preview" data-sqlbraid-preview data-testid="interactive-preview">
  <div class="preview-heading">
    <div>
      <p class="preview-kicker">Live browser preview</p>
      <h2>Real SQLBraid + SQLite WASM</h2>
      <p>
        The query runs in a Web Worker against an in-memory SQLite database. There is no
        demo executor, persistence requirement, or server connection.
      </p>
    </div>
    <span class="preview-badge">worker · :memory:</span>
  </div>

  <div class="preview-controls" aria-label="Preview filters">
    <label>
      <span>Korean accounts only</span>
      <input type="checkbox" data-preview-korean data-testid="preview-korean" checked />
    </label>
    <label>
      <span>Minimum balance (₩)</span>
      <input type="number" min="0" step="100000" value="1000000" data-preview-minimum data-testid="preview-minimum" />
    </label>
    <button type="button" data-preview-run data-testid="preview-run">Run query</button>
    <button type="button" data-browser-ownership-run data-testid="browser-ownership-run" hidden>
      Run browser ownership conformance
    </button>
  </div>

  <p class="preview-status" data-preview-status data-testid="preview-status" aria-live="polite">Ready to run.</p>
  <p class="preview-error" data-preview-error data-testid="preview-error" hidden></p>
  <p data-browser-ownership-status data-testid="browser-ownership-status" hidden></p>

  <div class="preview-grid">
    <div>
      <h3>TypeScript / SQL source</h3>
      <pre data-preview-source data-testid="preview-source"><code>const accounts = sql.rows(financeSchema)`
  SELECT account_id AS accountId,
         account_name AS accountName,
         balance,
         currency,
         locale
  FROM finance_accounts
  /*@braid where*/
    /*@braid if $&#123;koreanOnly&#125;*/
      AND locale = $&#123;"ko-KR"&#125;
    /*@braid end*/
    /*@braid if $&#123;minimumBalance &gt; 0&#125;*/
      AND balance &gt;= $&#123;minimumBalance&#125;
    /*@braid end*/
  /*@braid end*/
  ORDER BY account_id
`;</code></pre>
    </div>
    <div>
      <h3>Rendered SQL</h3>
      <pre data-preview-rendered data-testid="preview-rendered"><code>Run the preview to render this statement.</code></pre>
      <h3>Bind values</h3>
      <pre data-preview-binds data-testid="preview-binds"><code>[]</code></pre>
    </div>
  </div>

  <div class="preview-results">
    <h3>Standard Schema transformed rows</h3>
    <div class="preview-table-wrap">
      <table data-preview-table data-testid="preview-table">
        <thead></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</section>

<script>
  interface PreviewRow {
    readonly [key: string]: unknown;
  }

  interface PreviewSuccess {
    readonly type: "success";
    readonly source: string;
    readonly renderedSql: string;
    readonly binds: readonly unknown[];
    readonly rows: readonly PreviewRow[];
  }

  interface PreviewFailure {
    readonly type: "error";
    readonly code: string;
    readonly message: string;
  }

  const roots = document.querySelectorAll<HTMLElement>("[data-sqlbraid-preview]");
  for (const root of roots) {
    const worker = new Worker(new URL("../workers/preview.worker.ts", import.meta.url), { type: "module" });
    const ownershipWorker = new Worker(new URL("../workers/runtime-ownership.worker.ts", import.meta.url), { type: "module" });
    const korean = root.querySelector<HTMLInputElement>("[data-preview-korean]");
    const minimum = root.querySelector<HTMLInputElement>("[data-preview-minimum]");
    const runButton = root.querySelector<HTMLButtonElement>("[data-preview-run]");
    const status = root.querySelector<HTMLElement>("[data-preview-status]");
    const error = root.querySelector<HTMLElement>("[data-preview-error]");
    const source = root.querySelector<HTMLElement>("[data-preview-source] code");
    const rendered = root.querySelector<HTMLElement>("[data-preview-rendered] code");
    const binds = root.querySelector<HTMLElement>("[data-preview-binds] code");
    const table = root.querySelector<HTMLTableElement>("[data-preview-table]");
    const ownershipRun = root.querySelector<HTMLButtonElement>("[data-browser-ownership-run]");
    const ownershipStatus = root.querySelector<HTMLElement>("[data-browser-ownership-status]");
    if (!korean || !minimum || !runButton || !status || !error || !source || !rendered || !binds || !table || !ownershipRun || !ownershipStatus) {
      worker.terminate();
      ownershipWorker.terminate();
      continue;
    }

    const renderRows = (rows: readonly PreviewRow[]): void => {
      const columns = ["accountId", "accountName", "balance", "currency", "locale", "balanceLabel"];
      const head = table.tHead ?? table.createTHead();
      head.replaceChildren();
      const headerRow = head.insertRow();
      for (const column of columns) {
        const cell = document.createElement("th");
        cell.scope = "col";
        cell.textContent = column;
        headerRow.append(cell);
      }
      const body = table.tBodies[0] ?? table.createTBody();
      body.replaceChildren();
      for (const row of rows) {
        const tableRow = body.insertRow();
        for (const column of columns) {
          const cell = tableRow.insertCell();
          cell.textContent = String(row[column] ?? "");
        }
      }
      if (rows.length === 0) {
        const tableRow = body.insertRow();
        const cell = tableRow.insertCell();
        cell.colSpan = columns.length;
        cell.textContent = "No matching accounts.";
      }
    };

    worker.addEventListener("message", (event: MessageEvent<PreviewSuccess | PreviewFailure>) => {
      runButton.disabled = false;
      if (event.data.type === "error") {
        status.textContent = `Error (${event.data.code})`;
        error.hidden = false;
        error.textContent = event.data.message;
        return;
      }
      status.textContent = `${event.data.rows.length} account${event.data.rows.length === 1 ? "" : "s"} returned.`;
      error.hidden = true;
      error.textContent = "";
      source.textContent = event.data.source;
      rendered.textContent = event.data.renderedSql;
      binds.textContent = JSON.stringify(event.data.binds, null, 2);
      renderRows(event.data.rows);
    });

    worker.addEventListener("error", (event) => {
      runButton.disabled = false;
      status.textContent = "Worker failed.";
      error.hidden = false;
      error.textContent = event.message || "The preview worker could not be loaded.";
    });

    ownershipWorker.addEventListener("message", (event: MessageEvent<{ readonly type: "success"; readonly checks: readonly string[] } | { readonly type: "error"; readonly code: string; readonly message: string }>) => {
      if (event.data.type === "error") {
        ownershipStatus.hidden = false;
        delete ownershipStatus.dataset.checks;
        ownershipStatus.textContent = `Browser ownership error (${event.data.code}): ${event.data.message}`;
        return;
      }
      ownershipStatus.hidden = false;
      ownershipStatus.dataset.checks = event.data.checks.join(",");
      ownershipStatus.textContent = `Browser ownership conformance passed (${event.data.checks.length} checks).`;
    });

    ownershipWorker.addEventListener("error", (event) => {
      ownershipStatus.hidden = false;
      delete ownershipStatus.dataset.checks;
      ownershipStatus.textContent = `Browser ownership worker failed: ${event.message || "unknown error"}`;
    });

    runButton.addEventListener("click", () => {
      runButton.disabled = true;
      status.textContent = "Loading SQLite WASM and running query…";
      error.hidden = true;
      error.textContent = "";
      worker.postMessage({
        type: "run",
        koreanOnly: korean.checked,
        minimumBalance: minimum.valueAsNumber,
      });
    });

    ownershipRun.addEventListener("click", () => {
      ownershipStatus.hidden = false;
      ownershipStatus.textContent = "Running browser ownership conformance…";
      ownershipWorker.postMessage({ type: "run" });
    });
  }
</script>

<style>
  .sqlbraid-preview {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin: 2rem 0;
    background: var(--sl-color-gray-7);
  }

  .preview-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .preview-heading h2,
  .preview-heading p {
    margin: 0;
  }

  .preview-heading h2 {
    margin-top: 0.25rem;
  }

  .preview-kicker {
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .preview-badge {
    border: 1px solid var(--sl-color-accent);
    border-radius: 999px;
    color: var(--sl-color-accent);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
  }

  .preview-controls {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 1.25rem 0 0.5rem;
  }

  .preview-controls label {
    display: grid;
    gap: 0.3rem;
    font-size: 0.85rem;
  }

  .preview-controls label:first-child {
    align-items: center;
    display: flex;
    gap: 0.45rem;
    padding-bottom: 0.45rem;
  }

  .preview-controls input[type="number"] {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    padding: 0.4rem 0.5rem;
    width: 10rem;
  }

  .preview-controls button {
    background: var(--sl-color-accent);
    border: 0;
    border-radius: 0.35rem;
    color: var(--sl-color-white);
    cursor: pointer;
    font: inherit;
    font-weight: 650;
    padding: 0.45rem 0.8rem;
  }

  .preview-controls button:disabled {
    cursor: progress;
    opacity: 0.65;
  }

  .preview-status {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    min-height: 1.35rem;
  }

  .preview-error {
    background: color-mix(in srgb, var(--sl-color-red-high) 18%, transparent);
    border: 1px solid var(--sl-color-red-high);
    border-radius: 0.35rem;
    color: var(--sl-color-red-high);
    padding: 0.55rem 0.7rem;
  }

  .preview-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .preview-grid h3,
  .preview-results h3 {
    font-size: 0.95rem;
    margin-bottom: 0.45rem;
  }

  .preview-grid pre {
    min-height: 9rem;
  }

  .preview-grid pre,
  .preview-results {
    margin: 0;
  }

  .preview-grid pre code {
    font-size: 0.75rem;
    white-space: pre-wrap;
  }

  .preview-results {
    margin-top: 1.25rem;
  }

  .preview-table-wrap {
    overflow-x: auto;
  }

  .preview-table-wrap table {
    border-collapse: collapse;
    font-size: 0.82rem;
    width: 100%;
  }

  .preview-table-wrap th,
  .preview-table-wrap td {
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.45rem 0.55rem;
    text-align: left;
    white-space: nowrap;
  }

  .preview-table-wrap th {
    background: var(--sl-color-gray-6);
  }
</style>
