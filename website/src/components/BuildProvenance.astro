---
const channel = process.env.SQLBRAID_DOCS_CHANNEL || "latest";
const version = process.env.SQLBRAID_DOCS_VERSION || "";
const sha = process.env.GITHUB_SHA || "main";
const runId = process.env.GITHUB_RUN_ID || "";
const ref = process.env.GITHUB_REF || "";
const commitUrl = `https://github.com/Clickin/SQLBraid/commit/${sha}`;
const runUrl = runId ? `https://github.com/Clickin/SQLBraid/actions/runs/${runId}` : "https://github.com/Clickin/SQLBraid/actions";
const evidenceBase = "https://api.github.com/repos/Clickin/SQLBraid/actions/workflows";
const releaseSource = channel === "release" && version
  ? `release tag v${version}`
  : "latest docs from main";
const sourceRef = ref || (channel === "release" && version ? `refs/tags/v${version}` : "refs/heads/main");
---

<div class="build-provenance">
  <p>
    <strong>{releaseSource}:</strong>
    <a href={commitUrl}>{sha}</a> ({sourceRef})
    · <a href={runUrl}>{runId ? `workflow run ${runId}` : "workflow history"}</a>
  </p>
  {sha !== "main" && (
    <p>
      Exact-commit evidence:
      {" "}<a href={`${evidenceBase}/runtime-portability.yml/runs?head_sha=${sha}`}>runtime runs (JSON)</a>
      {" · "}<a href={`${evidenceBase}/release.yml/runs?head_sha=${sha}`}>immutable release runs and artifacts (JSON)</a>.
      Each result includes its run URL and conclusion; an empty or unfinished run is not a pass.
    </p>
  )}
  <p>
    These links identify the docs build candidate only. A successful Pages build does not claim that runtime,
    package, database, VS Code, or publication gates passed; consult individual checks and the release evidence artifact.
  </p>
</div>
