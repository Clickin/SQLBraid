---
import DefaultSocialIcons from "@astrojs/starlight/components/SocialIcons.astro";

const channel = process.env.SQLBRAID_DOCS_CHANNEL ?? "dev";
const version = process.env.SQLBRAID_DOCS_VERSION ?? "";
const versionsValue = process.env.SQLBRAID_DOCS_VERSIONS ?? "[]";
const publicRoot = "/SQLBraid";
const route = Astro.locals.starlightRoute;
const currentValue = channel === "release" && version ? version : "dev";
let versions: string[] = [];
try {
  const parsed = JSON.parse(versionsValue);
  if (Array.isArray(parsed)) versions = parsed.filter((entry) => typeof entry === "string");
} catch {
  versions = [];
}
if (channel === "release" && version && !versions.includes(version)) versions.push(version);
versions = [...new Set(versions)];
---

<DefaultSocialIcons />
<label class="docs-version-select">
  <span>{route.locale === "ko" ? "문서 버전" : "Docs version"}</span>
  <select
    data-docs-version
    data-docs-page={route.locale === "ko" ? route.id.replace(/^ko\/?/u, "") : route.id}
    data-docs-locale={route.locale ?? "root"}
    data-docs-current={currentValue}
    data-docs-index={`${publicRoot}/versions.json`}
  >
    <option value="dev" selected={currentValue === "dev"}>{route.locale === "ko" ? "개발 버전" : "Development"}</option>
    {versions.map((entry) => (
      <option value={entry} selected={entry === currentValue}>{entry}</option>
    ))}
  </select>
</label>

<script>
  import { routeForVersion } from "../../version-routes.mjs";
  type VersionIndex = {
    versions?: unknown;
    pages?: Record<string, Record<string, string[]>>;
  };

  const selectors = document.querySelectorAll<HTMLSelectElement>("select[data-docs-version]");

  async function loadVersionOptions() {
    for (const select of selectors) {
      try {
        const indexUrl = select.dataset.docsIndex;
        if (!indexUrl) continue;
        const response = await fetch(indexUrl);
        if (!response.ok) continue;
        const index = await response.json() as VersionIndex;
        const historical = Array.isArray(index.versions)
          ? index.versions.filter((value): value is string => typeof value === "string")
          : [];
        const values = ["dev", ...historical];
        for (const value of values) {
          if ([...select.options].some((option) => option.value === value)) continue;
          const option = document.createElement("option");
          option.value = value;
          option.textContent = value === "dev" ? "Development" : value;
          select.append(option);
        }
        select.value = select.dataset.docsCurrent ?? "dev";
      } catch {
        // A release archive must remain usable even while the index is unavailable.
      }
    }
  }

  for (const select of selectors) {
    select.addEventListener("change", async () => {
      const value = select.value;
      let index;
      try {
        const indexUrl = select.dataset.docsIndex;
        if (!indexUrl) return;
        const response = await fetch(indexUrl);
        if (response.ok) index = await response.json();
      } catch {
        // A release archive must remain usable even while the index is unavailable.
      }
      const target = routeForVersion({ version: value, locale: select.dataset.docsLocale, page: select.dataset.docsPage, pages: index?.pages });
      const hash = index?.pages?.[value]?.[select.dataset.docsLocale ?? "root"]?.includes(select.dataset.docsPage ?? "")
        ? window.location.hash
        : "";
      window.location.assign(`${target}${hash}`);
    });
  }

  void loadVersionOptions();
</script>

<style>
  .docs-version-select {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
  }

  .docs-version-select span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .docs-version-select select {
    max-width: 9rem;
    color: inherit;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.2rem 1.5rem 0.2rem 0.4rem;
  }
</style>
