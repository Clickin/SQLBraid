---
interface Props {
  locale?: "en" | "ko";
}

const { locale = "en" } = Astro.props;
const copy =
  locale === "ko"
    ? {
        overview: "실행 경로",
        overviewHelp: "사용자가 작성한 SQL이 애플리케이션 값으로 돌아오기까지의 주요 경계입니다.",
        packages: "패키지 경계",
        packagesHelp: "실행 코어와 정적 tooling은 계약을 공유하지만 dependency 방향은 분리됩니다.",
        authoring: "SQL 작성",
        authoringDetail: "TypeScript + sql tag",
        query: "논리 Query",
        queryDetail: "IR + values + result kind",
        render: "RenderedStatement",
        renderDetail: "segments + parameters",
        binding: "Binding",
        bindingDetail: "placeholder / transport / reuse",
        runtime: "Runtime",
        runtimeDetail: "lease / scope / tx / stream",
        driver: "Driver adapter",
        driverDetail: "native API + result normalization",
        result: "Application value",
        resultDetail: "canonical result + mapping",
        core: "계약과 invariant",
        template: "작성과 rendering",
        runtimePkg: "물리 lifecycle",
        adapters: "DB/driver bridge",
        compiler: "source discovery / lowering",
        metadata: "database evidence",
        codegen: "model generation",
        tooling: "workspace / semantic tooling",
        clients: "LSP / CLI / VS Code / Vite",
      }
    : {
        overview: "Execution path",
        overviewHelp: "The major boundaries from authored SQL to application values.",
        packages: "Package boundaries",
        packagesHelp: "The execution core and static tooling share contracts while keeping dependency direction separate.",
        authoring: "SQL authoring",
        authoringDetail: "TypeScript + sql tag",
        query: "Logical Query",
        queryDetail: "IR + values + result kind",
        render: "RenderedStatement",
        renderDetail: "segments + parameters",
        binding: "Binding",
        bindingDetail: "placeholder / transport / reuse",
        runtime: "Runtime",
        runtimeDetail: "lease / scope / tx / stream",
        driver: "Driver adapter",
        driverDetail: "native API + result normalization",
        result: "Application value",
        resultDetail: "canonical result + mapping",
        core: "contracts + invariants",
        template: "authoring + rendering",
        runtimePkg: "physical lifecycle",
        adapters: "DB/driver bridge",
        compiler: "source discovery / lowering",
        metadata: "database evidence",
        codegen: "model generation",
        tooling: "workspace / semantic tooling",
        clients: "LSP / CLI / VS Code / Vite",
      };

const execution = [
  ["01", copy.authoring, copy.authoringDetail],
  ["02", copy.query, copy.queryDetail],
  ["03", copy.render, copy.renderDetail],
  ["04", copy.binding, copy.bindingDetail],
  ["05", copy.runtime, copy.runtimeDetail],
  ["06", copy.driver, copy.driverDetail],
  ["07", copy.result, copy.resultDetail],
] as const;

const executionRows = [execution.slice(0, 3), execution.slice(3, 5), execution.slice(5)] as const;
---

<div class="architecture-overview">
  <section aria-labelledby="execution-flow-title">
    <div class="diagram-heading">
      <h2 id="execution-flow-title">{copy.overview}</h2>
      <p>{copy.overviewHelp}</p>
    </div>

    <div class="execution-stack" role="img" aria-label={copy.overviewHelp}>
      {
        executionRows.map((row, rowIndex) => (
          <>
            <div class="flow-row">
              {row.map(([index, title, detail], position) => (
                <div class="flow-item">
                  <article class="flow-card">
                    <span class="flow-index">{index}</span>
                    <strong>{title}</strong>
                    <small>{detail}</small>
                  </article>
                  {position < row.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
                </div>
              ))}
            </div>
            {rowIndex < executionRows.length - 1 && (
              <div class="flow-down" aria-hidden="true">
                ↓
              </div>
            )}
          </>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="package-flow-title">
    <div class="diagram-heading">
      <h2 id="package-flow-title">{copy.packages}</h2>
      <p>{copy.packagesHelp}</p>
    </div>

    <div class="package-map" role="img" aria-label={copy.packagesHelp}>
      <div class="lane">
        <div class="lane-label">runtime plane</div>
        <div class="package-card"><code>@sqlbraid/core</code><span>{copy.core}</span></div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="package-card"><code>@sqlbraid/template</code><span>{copy.template}</span></div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="package-card"><code>@sqlbraid/runtime</code><span>{copy.runtimePkg}</span></div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="package-card"><code>driver adapters</code><span>{copy.adapters}</span></div>
      </div>

      <div class="lane">
        <div class="lane-label">tooling plane</div>
        <div class="package-card"><code>@sqlbraid/compiler</code><span>{copy.compiler}</span></div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="tooling-stack">
          <div class="package-card"><code>@sqlbraid/metadata</code><span>{copy.metadata}</span></div>
          <span class="lane-arrow" aria-hidden="true">↓</span>
          <div class="package-card"><code>@sqlbraid/codegen</code><span>{copy.codegen}</span></div>
        </div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="package-card"><code>@sqlbraid/tooling</code><span>{copy.tooling}</span></div>
        <span class="lane-arrow" aria-hidden="true">↓</span>
        <div class="package-card"><code>consumers</code><span>{copy.clients}</span></div>
      </div>
    </div>
  </section>
</div>

<style>
  .architecture-overview {
    display: grid;
    gap: 2.25rem;
    max-width: 100%;
    margin: 1.5rem 0 2.5rem;
  }

  .diagram-heading {
    margin-bottom: 1rem;
  }

  .diagram-heading h2 {
    margin-bottom: 0.25rem;
  }

  .diagram-heading p {
    margin: 0;
    color: var(--sl-color-gray-3);
  }

  .execution-stack {
    display: grid;
    gap: 0.25rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .flow-row {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .flow-item {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    max-width: 17rem;
  }

  .flow-card,
  .package-card {
    min-width: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-bg) 92%, var(--sl-color-accent-low));
    box-shadow: 0 0.35rem 1.4rem color-mix(in srgb, var(--sl-color-black) 8%, transparent);
    overflow-wrap: anywhere;
  }

  .flow-card {
    display: grid;
    gap: 0.18rem;
    width: 100%;
    min-height: 6.6rem;
    padding: 0.85rem;
  }

  .flow-index {
    width: max-content;
    border-radius: 999px;
    padding: 0.08rem 0.45rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font: 700 0.72rem/1.4 var(--sl-font-system-mono);
  }

  .flow-card strong {
    margin-top: 0.25rem;
  }

  .flow-card small,
  .package-card span {
    color: var(--sl-color-gray-3);
    line-height: 1.35;
  }

  .flow-arrow,
  .flow-down,
  .lane-arrow {
    color: var(--sl-color-accent-high);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .flow-arrow {
    flex: 0 0 auto;
    align-self: center;
    padding: 0 0.15rem;
  }

  .flow-down {
    justify-self: center;
    line-height: 1;
  }

  .package-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .lane {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: stretch;
    gap: 0.35rem;
    min-width: 0;
    padding: 2.4rem 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--sl-color-bg-nav) 65%, transparent);
  }

  .lane-label {
    position: absolute;
    top: 0.65rem;
    left: 0.8rem;
    color: var(--sl-color-gray-3);
    font: 700 0.7rem/1.2 var(--sl-font-system-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .package-card {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem;
  }

  .package-card code {
    color: var(--sl-color-white);
    background: transparent;
    padding: 0;
    font-weight: 700;
  }

  .lane-arrow {
    justify-self: center;
    line-height: 1;
  }

  .tooling-stack {
    display: grid;
    gap: 0.35rem;
  }

  @media (max-width: 50rem) {
    .flow-row {
      display: grid;
      gap: 0.25rem;
    }

    .flow-item {
      display: grid;
      max-width: none;
    }

    .flow-card {
      min-height: 0;
    }

    .flow-arrow {
      justify-self: center;
      transform: rotate(90deg);
      padding: 0.1rem;
    }

    .package-map {
      grid-template-columns: 1fr;
    }
  }
</style>
