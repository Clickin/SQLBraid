{
  "name": "sqlbraid-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "pnpm run build && vitest run --project unit --project cli --project db-sqlite",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:db": "pnpm run build && vitest run --project db-postgres --project db-mysql --project db-sqlite",
    "test:db:postgres": "pnpm run build && vitest run --project db-postgres",
    "test:db:mysql": "pnpm run build && vitest run --project db-mysql",
    "test:db:sqlite": "pnpm run build && vitest run --project db-sqlite",
    "test:consumer": "pnpm run build && vitest run --project consumer && pnpm run pack:check",
    "test:all": "pnpm run typecheck && pnpm run build && vitest run && pnpm run pack:check",
    "pack:check": "node scripts/validate-packages.mjs",
    "test:runtime:node": "node scripts/runtime-portability.mjs node",
    "test:runtime:bun": "node scripts/runtime-portability.mjs bun",
    "test:runtime:deno": "node scripts/runtime-portability.mjs deno",
    "test:runtime": "node scripts/runtime-portability.mjs node bun deno",
    "sqlbraid": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@sqlbraid/cli": "workspace:*",
    "@sqlbraid/codegen": "workspace:*",
    "@sqlbraid/compiler": "workspace:*",
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/language-server": "workspace:*",
    "@sqlbraid/mysql": "workspace:*",
    "@sqlbraid/operations": "workspace:*",
    "@sqlbraid/postgres": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/metadata": "workspace:*",
    "@sqlbraid/sqlite": "workspace:*",
    "@sqlbraid/template": "workspace:*",
    "@standard-schema/spec": "1.1.0",
    "@testcontainers/mysql": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "publint": "0.3.24",
    "testcontainers": "12.1.0",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "valibot": "1.5.0",
    "vite": "7.0.0",
    "vitest": "5.0.0",
    "zod": "4.6.2"
  }
}
