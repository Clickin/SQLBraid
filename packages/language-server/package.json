{
  "name": "@sqlbraid/language-server",
  "version": "1.0.1",
  "description": "SQLBraid language server for SQL-aware TypeScript tooling",
  "keywords": [
    "database",
    "lsp",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/language-server"
  },
  "bin": {
    "sqlbraid-language-server": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/compiler": "workspace:^1.0.0",
    "@sqlbraid/core": "workspace:^1.0.0",
    "@sqlbraid/metadata": "workspace:^1.0.0",
    "@sqlbraid/tooling": "workspace:^1.0.0",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
