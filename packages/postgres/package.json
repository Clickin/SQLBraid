{
  "name": "@sqlbraid/postgres",
  "version": "1.0.0",
  "description": "SQLBraid PostgreSQL dialect, pg adapter, and metadata inspector",
  "keywords": [
    "database",
    "postgresql",
    "query",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/postgres"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/template": "workspace:*"
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:*",
    "@types/pg-cursor": "2.7.2",
    "pg-cursor": "^2.22.0"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:*",
    "pg-cursor": "^2.22.0"
  },
  "peerDependenciesMeta": {
    "pg-cursor": {
      "optional": true
    },
    "@sqlbraid/metadata": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.20.2"
  }
}
