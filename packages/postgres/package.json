{
  "name": "@sqlbraid/postgres",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/template": "workspace:*"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  }
}
