{
  "name": "@sqlbraid/cli",
  "version": "0.1.0-rc.1",
  "description": "SQLBraid command-line tools for inspecting projects and generating typed models",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "codegen", "cli"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "bin": { "sqlbraid": "./dist/index.js" },
  "dependencies": {
    "@sqlbraid/codegen": "workspace:*",
    "@sqlbraid/compiler": "workspace:*",
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/metadata": "workspace:*",
    "@sqlbraid/operations": "workspace:*",
    "@sqlbraid/tooling": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  }
}
