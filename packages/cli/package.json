{
  "name": "@sqlbraid/cli",
  "version": "1.0.1",
  "description": "SQLBraid command-line tools for inspecting projects and generating typed models",
  "keywords": [
    "cli",
    "codegen",
    "database",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sqlbraid": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/codegen": "workspace:^1.0.0",
    "@sqlbraid/compiler": "workspace:^1.0.0",
    "@sqlbraid/core": "workspace:^1.0.0",
    "@sqlbraid/metadata": "workspace:^1.0.0",
    "@sqlbraid/operations": "workspace:^1.0.0",
    "@sqlbraid/tooling": "workspace:^1.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
