{
  "name": "@sqlbraid/mariadb",
  "version": "1.0.0-rc.2",
  "description": "SQLBraid MariaDB dialect and official Connector/Node.js adapter",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/mariadb"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "mariadb", "query"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=16.20.2" },
  "dependencies": {
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/template": "workspace:*"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:*",
    "mariadb": "3.5.4"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": {
      "optional": true
    },
    "mariadb": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mariadb": {
      "types": "./dist/mariadb.d.ts",
      "import": "./dist/mariadb.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  }
}
