{
  "name": "@sqlbraid/sqlite",
  "version": "0.1.0",
  "description": "SQLBraid SQLite dialect, node:sqlite adapter, and metadata inspector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "sqlite", "query"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/template": "workspace:*"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.ts",
      "import": "./dist/node-sqlite.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  }
}
