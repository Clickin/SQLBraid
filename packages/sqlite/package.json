{
  "name": "@sqlbraid/sqlite",
  "version": "1.0.1",
  "description": "SQLBraid SQLite dialect adapters for node:sqlite, better-sqlite3, libSQL, SQLite WASM, and Cloudflare D1, plus metadata inspection",
  "keywords": [
    "database",
    "query",
    "sql",
    "sqlite",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/sqlite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.ts",
      "import": "./dist/node-sqlite.js"
    },
    "./better-sqlite3": {
      "types": "./dist/better-sqlite3.d.ts",
      "import": "./dist/better-sqlite3.js"
    },
    "./libsql": {
      "types": "./dist/libsql.d.ts",
      "import": "./dist/libsql.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/core": "workspace:^1.0.0",
    "@sqlbraid/runtime": "workspace:^1.0.0",
    "@sqlbraid/template": "workspace:^1.0.0"
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:^1.0.0"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:^1.0.0"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.20.2"
  }
}
