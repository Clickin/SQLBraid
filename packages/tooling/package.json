{
  "name": "@sqlbraid/tooling",
  "version": "0.1.0-rc.0",
  "description": "SQLBraid Node-first semantic tooling shared by the CLI and language server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/tooling"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "lsp"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@sqlbraid/codegen": "workspace:*",
    "@sqlbraid/compiler": "workspace:*",
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/metadata": "workspace:*",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
