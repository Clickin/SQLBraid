{
  "name": "sqlbraid",
  "version": "2.0.0",
  "description": "SQLBraid's canonical SQL-first runtime package",
  "keywords": [
    "database",
    "query",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/sqlbraid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiled": {
      "types": "./dist/compiled.d.ts",
      "import": "./dist/compiled.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/core": "workspace:^1.1.0",
    "@sqlbraid/runtime": "workspace:^1.0.3",
    "@sqlbraid/template": "workspace:^1.0.3"
  },
  "engines": {
    "node": ">=16.20.2"
  }
}
