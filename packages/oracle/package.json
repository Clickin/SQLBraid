{
  "name": "@sqlbraid/oracle",
  "version": "0.1.0",
  "description": "SQLBraid Oracle dialect, node-oracledb adapter, and metadata inspector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/oracle"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "oracle", "query"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/runtime": "workspace:*",
    "@sqlbraid/template": "workspace:*"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:*",
    "oracledb": ">=7.0.1 <8"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": { "optional": true },
    "oracledb": { "optional": true }
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:*",
    "@types/oracledb": "7.0.3",
    "oracledb": "7.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oracledb": {
      "types": "./dist/oracledb.d.ts",
      "import": "./dist/oracledb.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  }
}
