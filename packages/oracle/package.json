{
  "name": "@sqlbraid/oracle",
  "version": "1.0.0",
  "description": "SQLBraid Oracle dialect, node-oracledb adapter, and metadata inspector",
  "keywords": [
    "database",
    "oracle",
    "query",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/oracle"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./oracledb": {
      "types": "./dist/oracledb.d.ts",
      "import": "./dist/oracledb.js"
    },
    "./inspector": {
      "types": "./dist/inspector.d.ts",
      "import": "./dist/inspector.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@sqlbraid/core": "workspace:^1.0.0",
    "@sqlbraid/runtime": "workspace:^1.0.0",
    "@sqlbraid/template": "workspace:^1.0.0"
  },
  "devDependencies": {
    "@sqlbraid/metadata": "workspace:^1.0.0",
    "@types/oracledb": "7.0.3",
    "oracledb": "7.0.1"
  },
  "peerDependencies": {
    "@sqlbraid/metadata": "workspace:^1.0.0",
    "oracledb": ">=7.0.1 <8"
  },
  "peerDependenciesMeta": {
    "@sqlbraid/metadata": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16.20.2"
  }
}
