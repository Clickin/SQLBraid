{
  "name": "@sqlbraid/runtime",
  "version": "0.1.0-rc.1",
  "description": "Execute typed SQLBraid queries with connection-safe transactions and result mapping",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "query"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@sqlbraid/core": "workspace:*"
  },
  "imports": {
    "#async-context": {
      "types": "./dist/async-context.d.ts",
      "browser": "./dist/async-context.browser.js",
      "node": "./dist/async-context.node.js",
      "workerd": "./dist/async-context.node.js",
      "deno": "./dist/async-context.node.js",
      "default": "./dist/async-context.browser.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
