{
  "name": "@sqlbraid/compiler",
  "version": "0.1.0-rc.0",
  "description": "Compile SQLBraid tagged templates into typed SQL query definitions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "keywords": ["sql", "typescript", "database", "query"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.18.0" },
  "dependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@sqlbraid/core": "workspace:*",
    "@sqlbraid/template": "workspace:*",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
