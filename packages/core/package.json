{
  "name": "@sqlbraid/core",
  "version": "1.0.0-rc.2",
  "description": "Core SQLBraid types and SQL template interfaces for typed database applications",
  "keywords": [
    "database",
    "query",
    "sql",
    "typescript"
  ],
  "homepage": "https://github.com/Clickin/SQLBraid#readme",
  "bugs": {
    "url": "https://github.com/Clickin/SQLBraid/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/SQLBraid.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "engines": {
    "node": ">=16.20.2"
  }
